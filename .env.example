# Copy this file to .env and fill in private values locally.
# Never commit real passwords, session secrets, or API keys.

# Required by the existing SQL/session features.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sql_chatbot
# Optional separate PostgreSQL connection for accumulated ERICA feed items.
# Add the same URL as the GitHub repository secret FEED_DATABASE_URL for scheduled sync.
# If omitted, local feed items are saved to data/erica-feed-index.json.
FEED_DATABASE_URL=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional cloud AI configuration. ERICA chat uses local Ollama by default.
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

NODE_ENV=development
PORT=5000

# Local Ollama configuration. ERICA chat uses Ollama even when OLLAMA_ENABLED=false.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
